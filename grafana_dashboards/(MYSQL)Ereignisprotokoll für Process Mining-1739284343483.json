          "id": 1,
          "title": "Ereignisprotokoll",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "trino-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "afur6ketl4ydce"
                      },
                      "spec": {
                        "format": 1,
                        "rawSQL": "WITH variable AS (\n    SELECT DISTINCT\n        process_instance_key,\n        TRIM(BOTH '\"' FROM CAST(var_value AS VARCHAR)) AS orderNumber\n    FROM mysql.camunda_secondary.\"variable\" AS v\n    WHERE v.\"var_name\" = 'orderNumber'\n),\norder_products AS (\n    SELECT\n        coi.order_id,\n        array_join(array_agg(CAST(coi.quantity AS VARCHAR) || 'x ' || coi.bike_model_id), ', ') AS products\n    FROM mysql.bpa_lab_demonstration_factory.customer_order_item AS coi\n    GROUP BY coi.order_id\n)\nSELECT\n    variable.orderNumber AS case_id,\n    flownode.flow_node_id AS activity,\n    flownode.start_date AS start_timestamp,\n    flownode.end_date AS end_timestamp,\n    flownode.state AS activity_state,\n    flownode.incident_key AS incident_occured,\n    orders.customer_name,\n    order_products.products\nFROM mysql.camunda_secondary.\"flow_node_instance\" AS flownode\nLEFT JOIN variable\n    ON flownode.process_instance_key = variable.process_instance_key\nLEFT JOIN mysql.bpa_lab_demonstration_factory.customer_order AS orders\n    ON variable.orderNumber = orders.customer_order_number\nLEFT JOIN order_products\n    ON orders.customer_order_number = order_products.order_id\nWHERE flownode.type NOT IN ('EXCLUSIVE_GATEWAY', 'RECEIVE_TASK')\n    AND variable.orderNumber IS NOT NULL\n    AND flownode.flow_node_id IS NOT NULL\n    AND flownode.start_date IS NOT NULL\n    AND flownode.end_date IS NOT NULL\n    AND flownode.start_date BETWEEN $__timeFrom() AND $__timeTo()\nORDER BY flownode.start_date"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
